[Unit]
Description=Spark Arena account-free platform
After=network-online.target
Wants=network-online.target
[Service]
User=spark-arena-platform
Group=spark-arena-platform
WorkingDirectory=/opt/spark-arena-platform/current
Environment=ARENA_PLATFORM_DATA=/var/lib/spark-arena-platform
Environment=ARENA_TRUSTED_PROXIES=127.0.0.1
ExecStart=/opt/spark-arena-platform/venv/bin/gunicorn --bind 127.0.0.1:8789 --workers 2 --threads 2 --timeout 30 --max-requests 1000 --max-requests-jitter 100 arena.platform_server:create_app()
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/spark-arena-platform
MemoryMax=256M
CPUQuota=50%
[Install]
WantedBy=multi-user.target
