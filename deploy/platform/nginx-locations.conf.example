# Include in the existing dedicated HTTPS Spark Arena server block.
# In http{} also define: limit_req_zone $binary_remote_addr zone=spark_arena_join:10m rate=1r/m;
location = /api/v1/join {
    limit_req zone=spark_arena_join burst=2 nodelay;
    limit_req_status 429;
    limit_except POST { deny all; }
    proxy_pass http://127.0.0.1:8789/v1/join;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For "";
}
location /api/ {
    proxy_pass http://127.0.0.1:8789/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For "";
}
location / {
    root /var/www/spark-arena-platform/current;
    index index.html;
    try_files $uri $uri/ =404;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; base-uri 'none'; frame-ancestors 'none'; form-action 'none'; object-src 'none'" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header Cache-Control no-cache always;
}
