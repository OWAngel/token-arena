# Example only. Install in a dedicated nginx http context after configuring the
# actual independent domain/TLS certificate. Do not replace an existing vhost.
limit_req_zone $binary_remote_addr zone=spark_arena_wechat:10m rate=2r/s;

server {
    listen 443 ssl;
    server_name arena.example.com;
    ssl_certificate /etc/letsencrypt/live/arena.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/arena.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 64k;
    client_body_timeout 10s;

    location / {
        limit_req zone=spark_arena_wechat burst=20 nodelay;
        proxy_pass http://127.0.0.1:8788;
        proxy_set_header Host $host;
        # Overwrite, do not trust a client-supplied forwarded address.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_request_buffering on;
    }
}
