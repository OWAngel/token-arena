.brand{display:flex;gap:12rpx;align-items:center;font-size:44rpx;font-weight:600;margin-bottom:48rpx}.bolt{display:inline-block;color:#a17b22;font-size:64rpx}.light{color:#748267;font-weight:400}.brand button{margin-left:auto;background:#283324;color:#fff;font-size:22rpx}.stats{display:flex;gap:20rpx;margin:28rpx 0}.stats>view{flex:1;background:#e8eddf;padding:28rpx;border-radius:16rpx;display:flex;flex-direction:column}.label{font-size:21rpx;letter-spacing:2rpx;color:#647454}.value{font-size:50rpx;line-height:1.8}.filters{display:flex;flex-wrap:wrap;gap:24rpx;align-items:center;justify-content:space-between;margin-bottom:16rpx}.periods{display:flex;background:#e4e9d9;border-radius:10rpx;padding:6rpx}.periods button{flex:none;width:112rpx;margin:0;box-sizing:border-box;padding:0 12rpx;font-size:24rpx;background:transparent;color:#79846b;line-height:2.4}.periods .selected{background:#fff;color:#2b3823}.model-picker{font-size:22rpx;max-width:270rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.person-card{border-bottom:1rpx solid #d8dfce}.person{display:flex;align-items:center;gap:20rpx;padding:28rpx 0}.rank{color:#ad8538;font:28rpx monospace;width:28rpx}.person-name{flex:1;min-width:0}.name{font-size:28rpx;display:block;font-weight:600}.identity{font-size:20rpx;display:block;color:#7b896c;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin-top:8rpx}.amount{font-size:30rpx;font-weight:600}.details{background:#e9eedf;padding:22rpx;margin-bottom:20rpx;border-radius:12rpx}.model-detail{display:flex;flex-direction:column;gap:10rpx;padding:16rpx 0;font-size:24rpx;overflow-wrap:anywhere}.foot{font-size:21rpx;color:#7d886f;text-align:center;line-height:1.9;margin:48rpx 0}.empty{text-align:center;padding:50rpx 20rpx;color:#768164}

