# Optional reporter environment. NEVER commit actual values in .env.
# .env is not automatically loaded; export in your local process or use the private token command.
SPARKDASH_TOKEN=
# Optional root for local reporter config (defaults to ~/.config):
XDG_CONFIG_HOME=
# GitHub CLI normally uses gh auth login. An optional GH_TOKEN can be provided by your own secret manager.
# GitHub Actions supplies its own ephemeral github.token; no participant credentials belong in repository secrets.
